/*
 * Every color here is a $an-* variable supplied by the active theme (see themes.py).
 * A theme has to define all of them, or the stylesheet fails to load.
 */

Screen {
    background: $an-bg;
    color: $an-fg;
}

ModalScreen {
    align: center middle;
    background: $an-bg-dark 70%;
}

.hidden {
    display: none;
}

* {
    scrollbar-background: $an-bg-dark;
    scrollbar-background-hover: $an-bg-dark;
    scrollbar-background-active: $an-bg-dark;
    scrollbar-color: $an-border;
    scrollbar-color-hover: $an-muted;
    scrollbar-color-active: $an-fg;
    scrollbar-corner-color: $an-bg-dark;
    scrollbar-size-vertical: 1;
}

/* Buttons: flat, one line tall. The .link variant is plain underlined text. */
Button {
    height: 1;
    min-width: 10;
    padding: 0 2;
    border: none;
    background: $an-surface-hi;
    color: $an-fg;
}

Button.-primary {
    background: $an-primary;
    color: $an-on-primary;
    text-style: bold;
}

Button.-success {
    background: $an-ok-bg;
    color: $an-ok;
}

Button.-warning {
    background: $an-warn-bg;
    color: $an-warn;
}

Button.-error {
    background: $an-error-bg;
    color: $an-error;
}

Button:hover {
    background-tint: $an-fg 12%;
}

Button:focus {
    text-style: bold;
    background-tint: $an-fg 8%;
}

Button:disabled {
    opacity: 50%;
}

Button.link {
    width: auto;
    min-width: 0;
    padding: 0;
    background: transparent;
    color: $an-fg;
    text-style: underline;
    text-align: left;
    content-align: left middle;
}

Button.link:hover {
    background: transparent;
    background-tint: transparent;
    text-style: bold underline;
}

Button.link:focus {
    background: $an-fg;
    background-tint: transparent;
    color: $an-bg;
    text-style: bold underline;
}

Button.link:disabled {
    opacity: 40%;
}

Input {
    height: 3;
    padding: 0 1;
    background: $an-surface-hi;
    color: $an-fg;
    border: tall $an-surface-hi;
}

Input:focus {
    border: tall $an-fg;
}

Input > .input--cursor {
    background: $an-fg;
    color: $an-bg-dark;
}

Input > .input--selection {
    background: $an-sel;
}

Input > .input--placeholder {
    color: $an-muted;
}

Input:disabled {
    opacity: 50%;
}

TextArea {
    background: $an-surface-hi;
    color: $an-fg;
    border: tall $an-surface-hi;
}

TextArea:focus {
    border: tall $an-fg;
}

TextArea > .text-area--cursor {
    background: $an-fg;
    color: $an-bg-dark;
}

TextArea > .text-area--cursor-line {
    background: $an-surface;
}

TextArea > .text-area--selection {
    background: $an-sel;
}

Input.invalid, TextArea.invalid {
    border: tall $an-error;
}

OptionList {
    background: transparent;
    border: none;
    padding: 0;
}

OptionList:focus {
    border: none;
}

OptionList > .option-list--option-hover {
    background: $an-surface;
}

OptionList > .option-list--option-highlighted {
    background: $an-surface-hi;
    color: $an-fg;
}

OptionList:focus > .option-list--option-highlighted {
    background: $an-sel;
    text-style: bold;
}

DataTable {
    background: $an-bg-dark;
    color: $an-fg;
}

DataTable > .datatable--header {
    background: $an-surface;
    color: $an-accent;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $an-surface;
}

DataTable > .datatable--cursor {
    background: $an-surface-hi;
    color: $an-fg;
}

DataTable:focus > .datatable--cursor {
    background: $an-sel;
    color: $an-fg;
}

ProgressBar Bar {
    width: 1fr;
}

Bar > .bar--bar {
    background: $an-surface;
    color: $an-fg;
}

Bar > .bar--complete {
    color: $an-ok;
}

Bar > .bar--indeterminate {
    background: $an-surface;
    color: $an-accent;
}

PercentageStatus, ETAStatus {
    color: $an-fg-dim;
}

Switch {
    width: auto;
    height: 3;
    margin-right: 2;
    padding: 0 1;
    background: $an-bg-dark;
    border: tall $an-border;
}

Switch:focus {
    border: tall $an-fg;
}

Switch > .switch--slider {
    background: $an-surface;
    color: $an-muted;
}

Switch.-on > .switch--slider {
    color: $an-ok;
}

RadioSet {
    height: auto;
    padding: 0;
    background: transparent;
    border: none;
}

RadioSet:focus {
    border: none;
}

ToggleButton {
    background: transparent;
    color: $an-fg;
}

ToggleButton > .toggle--button {
    background: $an-bg-dark;
    color: $an-muted;
}

ToggleButton.-on > .toggle--button {
    color: $an-accent;
}

ToggleButton:focus > .toggle--label {
    background: $an-sel;
    color: $an-fg;
    text-style: bold;
}

Toast {
    background: $an-surface;
    color: $an-fg;
}

Toast.-information {
    border-left: outer $an-fg;
}

Toast.-warning {
    border-left: outer $an-warn;
}

Toast.-error {
    border-left: outer $an-error;
}

Toast .toast--title {
    text-style: bold;
}

Tooltip {
    background: $an-surface;
    color: $an-fg;
    border: round $an-border;
}

CommandPalette {
    background: $an-bg-dark 70%;
}

CommandPalette > Vertical {
    background: $an-surface;
}

Markdown {
    padding: 0;
    background: transparent;
    color: $an-fg;
}

MarkdownH1 {
    background: transparent;
    color: $an-accent;
}

MarkdownH2 {
    background: transparent;
    color: $an-link;
}

MarkdownH3 {
    background: transparent;
    color: $an-user;
}

MarkdownFence {
    background: $an-surface;
}

MarkdownBlockQuote {
    background: transparent;
    border-left: outer $an-border;
}

/* Home screen: sidebar on the left, chat on the right. */
#home {
    height: 100%;
}

#sidebar {
    width: 38;
    height: 100%;
    padding: 1 2 0 2;
    background: $an-bg-dark;
    border-right: solid $an-border;
}

#brand-title {
    width: 100%;
    height: auto;
    color: $an-fg;
    text-style: bold;
    text-align: center;
}

#brand-tagline {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $an-fg-dim;
    text-align: center;
}

#brand-version {
    width: 100%;
    height: 1;
    color: $an-muted;
    text-align: center;
}

#history-section {
    height: 1fr;
    margin-top: 1;
    border-top: solid $an-border;
}

#history-header {
    height: 1;
    margin-top: 1;
}

#history-toggle {
    width: 1fr;
}

#history-list {
    height: 1fr;
    margin-top: 1;
}

.history-item {
    height: 1;
}

.history-item.active {
    background: $an-surface-hi;
}

Button.history-title {
    width: 1fr;
}

.history-item.active .history-title {
    text-style: bold underline;
}

Button.history-delete {
    width: 3;
    min-width: 3;
    text-style: none;
    content-align: center middle;
}

.history-empty {
    height: auto;
    color: $an-muted;
}

#status-section {
    height: auto;
    padding-top: 1;
    border-top: solid $an-border;
}

#status-box {
    height: auto;
    padding: 0 1;
    background: $an-surface-hi;
}

.status-row {
    height: 1;
}

.status-key {
    width: 8;
    color: $an-fg-dim;
}

#status-conn {
    width: auto;
    margin-right: 1;
    text-style: bold;
}

#status-conn.online {
    color: $an-ok;
}

#status-conn.offline {
    color: $an-error;
}

#status-conn.checking {
    color: $an-warn;
}

#status-url {
    width: 1fr;
    height: 1;
    color: $an-muted;
}

#status-model {
    width: 1fr;
    text-style: bold underline;
}

#tokens-row {
    height: 1;
    margin-top: 1;
}

#tokens-label {
    width: 9;
    padding-left: 1;
    color: $an-fg-dim;
}

#tokens-bar {
    width: 1fr;
    color: $an-fg;
}

#tokens-bar.warn {
    color: $an-warn;
}

#tokens-bar.full {
    color: $an-error;
}

#tokens-count {
    width: auto;
    color: $an-fg-dim;
}

#sidebar-footer {
    height: 1;
    margin: 1 0;
}

#btn-help {
    width: 1fr;
}

#btn-settings {
    width: auto;
}

#main {
    width: 1fr;
    height: 100%;
}

#main-topbar {
    height: 1;
    padding: 0 1;
    align-horizontal: right;
}

#btn-close {
    width: 3;
    min-width: 3;
    padding: 0;
    background: $an-fg;
    color: $an-bg;
    text-style: bold;
    content-align: center middle;
}

#chat-log {
    height: 1fr;
    padding: 1 2 0 2;
}

#chat-stats {
    height: 1;
    padding: 0 2;
    color: $an-muted;
}

#chat-input-row {
    height: auto;
    padding: 0 2 1 2;
}

#chat-input {
    width: 1fr;
}

#chat-input-row Button {
    height: 3;
    margin-left: 1;
    content-align: center middle;
}

.message {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border-left: thick $an-border;
}

.message-role {
    height: 1;
    text-style: bold;
}

.message-body {
    height: auto;
}

.message-thinking {
    height: auto;
    color: $an-think;
    text-style: italic;
}

.message.user {
    background: $an-surface;
    border-left: thick $an-user;
}

.message.user .message-role {
    color: $an-user;
}

.message.assistant {
    border-left: thick $an-assistant;
}

.message.assistant .message-role {
    color: $an-assistant;
}

.message.streaming {
    border-left: thick $an-accent;
}

.message.error {
    background: $an-error-bg;
    border-left: thick $an-error;
    color: $an-error;
}

.message.error .message-role {
    color: $an-error;
}

.message.system {
    border-left: thick $an-muted;
    color: $an-muted;
    text-style: italic;
}

.notice {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    background: $an-warn-bg;
    color: $an-warn;
}

.notice.error {
    background: $an-error-bg;
    border-left: thick $an-error;
    color: $an-error;
    text-style: bold;
}

.empty-state {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $an-muted;
}

/* Settings popup: navigation on the left, one pane at a time on the right. */
#settings-dialog {
    width: 90%;
    max-width: 110;
    height: 85%;
    max-height: 40;
    border: thick $an-border;
    background: $an-surface-hi;
}

#settings-nav {
    width: 28;
    height: 100%;
    padding: 1 2;
    background: $an-surface;
}

#settings-title {
    margin-bottom: 2;
    color: $an-fg;
    text-style: bold;
}

Button.nav-link {
    width: 100%;
    margin-bottom: 1;
}

Button.nav-link.active {
    color: $an-accent;
    text-style: bold underline;
}

#nav-back {
    dock: bottom;
}

#settings-content {
    width: 1fr;
    height: 100%;
}

.pane {
    height: 100%;
    padding: 1 2;
}

.pane-title {
    margin-bottom: 1;
    color: $an-accent;
    text-style: bold;
}

.field-label {
    margin-top: 1;
    color: $an-accent;
    text-style: bold;
}

.field-hint {
    color: $an-fg-dim;
}

.field-multiline {
    height: 8;
}

#settings-content Input,
#settings-content TextArea {
    max-width: 80;
    background: $an-bg-dark;
    border: tall $an-bg-dark;
}

#settings-content Input:focus,
#settings-content TextArea:focus {
    border: tall $an-fg;
}

#settings-content Input.invalid,
#settings-content TextArea.invalid {
    border: tall $an-error;
}

#settings-content .notice {
    margin: 1 0 0 0;
}

#settings-content .empty-state {
    background: $an-bg-dark;
}

.toolbar {
    height: auto;
    margin-bottom: 1;
}

.toolbar Button {
    margin-right: 1;
}

#models-table {
    height: 1fr;
}

.form-actions {
    height: auto;
    margin-top: 1;
}

.form-actions Button {
    margin-right: 1;
}

.power-row {
    height: auto;
    margin-top: 1;
}

#power-state {
    width: auto;
    margin-right: 2;
    text-style: bold;
}

#power-state.online {
    color: $an-ok;
}

#power-state.offline {
    color: $an-error;
}

#power-state.checking {
    color: $an-warn;
}

#power-note {
    margin-top: 1;
    color: $an-fg-dim;
}

.skill-row {
    height: auto;
    margin-bottom: 1;
}

.skill-info {
    width: 1fr;
    height: auto;
}

.skill-name {
    text-style: bold;
}

.skill-usage {
    color: $an-fg-dim;
}

.skill-desc {
    color: $an-fg-dim;
}

/* Dialogs: confirm, pull, model picker and help share one look. */
.dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $an-surface;
    border: thick $an-border;
}

.dialog.wide {
    width: 76;
}

.dialog.danger {
    border: thick $an-error;
}

.dialog-title {
    margin-bottom: 1;
    color: $an-accent;
    text-style: bold;
}

.dialog.danger .dialog-title {
    color: $an-error;
}

.dialog-body {
    height: auto;
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
}

.dialog-buttons Button {
    margin-left: 1;
}

.dialog OptionList {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
    background: $an-bg-dark;
}

#pull-progress {
    width: 100%;
    margin-bottom: 1;
}

#pull-status {
    height: auto;
    color: $an-fg-dim;
}

#help-body {
    height: auto;
    max-height: 24;
    margin-bottom: 1;
}
